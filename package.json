{
  "name": "jewish-zmanim",
  "version": "1.0.5",
  "description": "Jewish Zmanim",
  "keywords": [
    "zmanim",
    "jewish",
    "halacha",
    "halachic-times",
    "hebrew-calendar",
    "judaism",
    "torah",
    "shabbat",
    "shabbos",
    "candle-lighting",
    "havdalah",
    "sunrise",
    "sunset",
    "netz",
    "shkiah",
    "alos-hashachar",
    "tzeis",
    "chatzos",
    "krias-shema",
    "shaah-zmanis",
    "solar-calculations",
    "typescript"
  ],
  "author": "Shmulik Kravitz",
  "license": "MIT",
  "homepage": "https://github.com/Shmulik-Kravitz/jewish-zmanim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shmulik-Kravitz/jewish-zmanim.git"
  },
  "bugs": {
    "url": "https://github.com/Shmulik-Kravitz/jewish-zmanim/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn typecheck && yarn lint && yarn format && tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "check": "biome check src tests",
    "check:fix": "biome check --write src tests",
    "prepare": "husky || true",
    "inc-version": "yarn version patch",
    "get-version": "node -p \"require('./package.json').version\""
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "bumpp": "^12.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "geo-tz": "^8.1.8",
    "jewish-holidays": "^2.0.1"
  }
}
